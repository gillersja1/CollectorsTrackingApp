<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/LoginFragment">

    <fragment
        android:id="@+id/LoginFragment"
        android:name="com.example.collectorstrackingapp.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_LoginFragment_to_FirstFragment"
            app:destination="@id/FirstFragment"
            app:popUpTo="@id/LoginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.collectorstrackingapp.FirstFragment"
        android:label="My Collection"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />

        <action
            android:id="@+id/action_FirstFragment_to_CategoryManagementFragment"
            app:destination="@id/CategoryManagementFragment" />

        <action
            android:id="@+id/action_FirstFragment_to_SearchFragment"
            app:destination="@id/SearchFragment" />

        <action
            android:id="@+id/action_FirstFragment_to_LoginFragment"
            app:destination="@id/LoginFragment"
            app:popUpTo="@id/FirstFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/SearchFragment"
        android:name="com.example.collectorstrackingapp.SearchFragment"
        android:label="Search Collectibles"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/CategoryManagementFragment"
        android:name="com.example.collectorstrackingapp.CategoryManagementFragment"
        android:label="Manage Categories"
        tools:layout="@layout/fragment_category_management">
        <action
            android:id="@+id/action_CategoryManagementFragment_to_CategoryDetailsFragment"
            app:destination="@id/CategoryDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/CategoryDetailsFragment"
        android:name="com.example.collectorstrackingapp.CategoryDetailsFragment"
        android:label="Category Items"
        tools:layout="@layout/fragment_category_details">
        <argument
            android:name="categoryName"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.collectorstrackingapp.SecondFragment"
        android:label="Add Collectible"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />

        <argument
            android:name="collectibleId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>
</navigation>
