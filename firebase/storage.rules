rules_version = '2';

// Photos live under users/{uid}/images: only that signed-in user can upload, read or delete them.
// (The app shows photos through their download URLs, which carry their own access token.)
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{uid}/images/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // Uploads: at most 10 MB, and an image if the type is known.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType == null || request.resource.contentType.matches('image/.*'));
    }

    // Anything else in the bucket is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
