{
  "name": "collectors-tracking-app-security-rules",
  "private": true,
  "description": "Tests for the Firestore security rules, run against the Firebase emulators.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --project demo-collectors --config ../firebase.json --only firestore \"node --test tests/rules.test.js\"",
    "test:only": "node --test tests/rules.test.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0"
  }
}
