rules_version = '2';

// Each user's collection lives under users/{uid}: only that signed-in user can read or change it.
// Everything else in the database is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Field checks for a saved item: the shape the app writes, with sane sizes.
    // cloudId is optional because builds before the cloud-id change didn't send it; when sent it must
    // match the document id, so an item can't claim to be another one.
    function validCollectible(id) {
      let d = request.resource.data;
      return d.name is string && d.name.size() <= 200
        && d.category is string && d.category.size() <= 100
        && d.description is string && d.description.size() <= 5000
        && (!('cloudId' in d) || d.cloudId == id)
        && (!('imagePath' in d) || (d.imagePath is string && d.imagePath.size() <= 2000))
        && (!('tags' in d) || (d.tags is string && d.tags.size() <= 1000))
        && (!('isWishlist' in d) || d.isWishlist is bool)
        && (!('estimatedValue' in d) || d.estimatedValue is number);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);

      match /collectibles/{collectibleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCollectible(collectibleId);
      }

      // Photos, stored here instead of in Firebase Storage (which needs a billing account). The app shrinks
      // each one to a JPEG of at most 700 KB; the cap here leaves room under Firestore's 1 MiB per document.
      match /photos/{photoId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 900 * 1024
          && request.resource.data.contentType == 'image/jpeg';
      }

      match /categories/{categoryName} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name == categoryName
          && categoryName.size() <= 100;
      }
    }
  }
}
